{
  "name": "@workspace/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Public contracts — DTOs, event schemas, API contracts, Zod schemas.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./api": {
      "types": "./src/api/index.ts",
      "import": "./src/api/index.ts"
    },
    "./events": {
      "types": "./src/events/index.ts",
      "import": "./src/events/index.ts"
    },
    "./dto": {
      "types": "./src/dto/index.ts",
      "import": "./src/dto/index.ts"
    },
    "./schemas": {
      "types": "./src/schemas/index.ts",
      "import": "./src/schemas/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
