{
  "name": "@workspace/ai",
  "version": "0.1.0",
  "private": true,
  "description": "Decoupled AI layer with interchangeable providers — core, providers, prompts, embeddings, RAG, evaluation, tools.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./core": {
      "types": "./src/core/index.ts",
      "import": "./src/core/index.ts"
    },
    "./providers": {
      "types": "./src/providers/index.ts",
      "import": "./src/providers/index.ts"
    },
    "./prompts": {
      "types": "./src/prompts/index.ts",
      "import": "./src/prompts/index.ts"
    },
    "./embeddings": {
      "types": "./src/embeddings/index.ts",
      "import": "./src/embeddings/index.ts"
    },
    "./rag": {
      "types": "./src/rag/index.ts",
      "import": "./src/rag/index.ts"
    },
    "./evaluation": {
      "types": "./src/evaluation/index.ts",
      "import": "./src/evaluation/index.ts"
    },
    "./tools": {
      "types": "./src/tools/index.ts",
      "import": "./src/tools/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
