{
  "name": "@workspace/observability",
  "version": "0.1.0",
  "private": true,
  "description": "Observability layer — logger, metrics, tracing, instrumentation.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./logger": {
      "types": "./src/logger/index.ts",
      "import": "./src/logger/index.ts"
    },
    "./metrics": {
      "types": "./src/metrics/index.ts",
      "import": "./src/metrics/index.ts"
    },
    "./tracing": {
      "types": "./src/tracing/index.ts",
      "import": "./src/tracing/index.ts"
    },
    "./instrumentation": {
      "types": "./src/instrumentation/index.ts",
      "import": "./src/instrumentation/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
