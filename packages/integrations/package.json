{
  "name": "@workspace/integrations",
  "version": "0.2.0",
  "private": true,
  "description": "Supplier + manufacturer adapters (eBay, DigiKey, Amazon, ...) with hybrid Transport layer (FetchTransport + ReplayTransport).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./transports": {
      "types": "./src/transports/index.ts",
      "import": "./src/transports/index.ts"
    },
    "./connectors": {
      "types": "./src/connectors/index.ts",
      "import": "./src/connectors/index.ts"
    },
    "./connectors/ebay": {
      "types": "./src/connectors/ebay/index.ts",
      "import": "./src/connectors/ebay/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
