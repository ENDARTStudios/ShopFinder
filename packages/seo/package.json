{
  "name": "@workspace/seo",
  "version": "0.1.0",
  "private": true,
  "description": "SEO layer — metadata, schema.org JSON-LD, robots, sitemap.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./metadata": {
      "types": "./src/metadata/index.ts",
      "import": "./src/metadata/index.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "import": "./src/schema/index.ts"
    },
    "./robots": {
      "types": "./src/robots/index.ts",
      "import": "./src/robots/index.ts"
    },
    "./sitemap": {
      "types": "./src/sitemap/index.ts",
      "import": "./src/sitemap/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
