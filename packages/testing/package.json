{
  "name": "@workspace/testing",
  "version": "0.1.0",
  "private": true,
  "description": "Shared test infrastructure — Vitest config, utils, mocks, fixtures.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "import": "./src/utils/index.ts"
    },
    "./mocks": {
      "types": "./src/mocks/index.ts",
      "import": "./src/mocks/index.ts"
    },
    "./fixtures": {
      "types": "./src/fixtures/index.ts",
      "import": "./src/fixtures/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workspace/domain": "workspace:*",
    "@workspace/contracts": "workspace:*"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
