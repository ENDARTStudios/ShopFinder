{
  "name": "dropshipping-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Global Dropshipping Platform — Modular Monolith on Next.js 16 + Turborepo workspaces.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "echo 'no tests yet' && exit 0",
    "test:arch": "node scripts/architecture-test.mjs",
    "turbo": "turbo",
    "turbo:lint": "turbo lint",
    "turbo:typecheck": "turbo typecheck",
    "turbo:build": "turbo build",
    "db:select-provider": "bun run scripts/select-prisma-provider.ts",
    "db:push": "bun run scripts/select-prisma-provider.ts && prisma db push",
    "db:generate": "bun run scripts/select-prisma-provider.ts && prisma generate",
    "db:migrate": "bun run scripts/select-prisma-provider.ts && prisma migrate dev",
    "db:reset": "bun run scripts/select-prisma-provider.ts && prisma migrate reset",
    "db:seed": "bun run scripts/seed.ts",
    "db:studio": "prisma studio",
    "prepare": "husky",
    "postinstall": "bun run scripts/select-prisma-provider.ts && prisma generate",
    "vercel-build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "clean": "rm -rf .next .turbo node_modules/.cache **/dist **/.turbo"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
