{
  "extends": "./packages/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@workspace/ui": ["./packages/ui/src/index.ts"],
      "@workspace/ui/*": ["./packages/ui/src/*"],
      "@workspace/ui/tokens": ["./packages/ui/src/tokens/index.ts"],
      "@workspace/ui/primitives": ["./packages/ui/src/primitives/index.ts"],
      "@workspace/ui/commerce": ["./packages/ui/src/commerce/index.ts"],
      "@workspace/ui/admin": ["./packages/ui/src/admin/index.ts"],
      "@workspace/ui/marketing": ["./packages/ui/src/marketing/index.ts"],
      "@workspace/ui/charts": ["./packages/ui/src/charts/index.ts"],
      "@workspace/shared": ["./packages/shared/src/index.ts"],
      "@workspace/shared/*": ["./packages/shared/src/*"],
      "@workspace/types": ["./packages/types/src/index.ts"],
      "@workspace/types/*": ["./packages/types/src/*"],
      "@workspace/config/*": ["./packages/config/*"],
      "@workspace/database": ["./packages/database/src/index.ts"],
      "@workspace/database/*": ["./packages/database/src/*"],
      "@workspace/database/repositories": ["./packages/database/src/repositories/index.ts"],
      "@workspace/database/mappers": ["./packages/database/src/mappers/index.ts"],
      "@workspace/database/unit-of-work": ["./packages/database/src/unit-of-work/index.ts"],
      "@workspace/database/cache": ["./packages/database/src/cache/index.ts"],
      "@workspace/auth": ["./packages/auth/src/index.ts"],
      "@workspace/auth/*": ["./packages/auth/src/*"],
      "@workspace/validation": ["./packages/validation/src/index.ts"],
      "@workspace/validation/*": ["./packages/validation/src/*"],
      "@workspace/analytics": ["./packages/analytics/src/index.ts"],
      "@workspace/analytics/*": ["./packages/analytics/src/*"],
      "@workspace/seo": ["./packages/seo/src/index.ts"],
      "@workspace/seo/*": ["./packages/seo/src/*"],
      "@workspace/ai": ["./packages/ai/src/index.ts"],
      "@workspace/ai/*": ["./packages/ai/src/*"],
      "@workspace/integrations": ["./packages/integrations/src/index.ts"],
      "@workspace/integrations/*": ["./packages/integrations/src/*"],
      "@workspace/domain": ["./packages/domain/src/index.ts"],
      "@workspace/domain/*": ["./packages/domain/src/*"],
      "@workspace/domain/repositories": ["./packages/domain/src/repositories/index.ts"],
      "@workspace/domain/services": ["./packages/domain/src/services/index.ts"],
      "@workspace/domain/specifications": ["./packages/domain/src/specifications/index.ts"],
      "@workspace/domain/queries": ["./packages/domain/src/queries/index.ts"],
      "@workspace/contracts": ["./packages/contracts/src/index.ts"],
      "@workspace/contracts/*": ["./packages/contracts/src/*"],
      "@workspace/testing": ["./packages/testing/src/index.ts"],
      "@workspace/testing/*": ["./packages/testing/src/*"],
      "@workspace/observability": ["./packages/observability/src/index.ts"],
      "@workspace/observability/*": ["./packages/observability/src/*"],
      "@workspace/i18n": ["./packages/i18n/src/index.ts"],
      "@workspace/i18n/*": ["./packages/i18n/src/*"],
      "@workspace/application": ["./packages/application/src/index.ts"],
      "@workspace/application/*": ["./packages/application/src/*"],
      "@workspace/providers": ["./packages/providers/src/index.ts"],
      "@workspace/bootstrap": ["./packages/bootstrap/src/index.ts"],
      "@workspace/events": ["./packages/events/src/index.ts"],
      "@workspace/jobs": ["./packages/jobs/src/index.ts"],
      "@workspace/api": ["./packages/api/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "scripts/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "dist", "build", "examples", "skills", "packages"]
}
