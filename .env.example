# ── Banco / Cache ────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
REDIS_URL=rediss://default:password@host:6379
UPSTASH_REDIS_REST_URL=https://<your-region>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-token>

# ── Auth (gerar: openssl rand -base64 32) ───────────────────────
JWT_SECRET=<generate-with-openssl-rand-base64-32>
NEXTAUTH_SECRET=<generate-with-openssl-rand-base64-32>
NEXTAUTH_URL=http://localhost:3000

# ── Pagamento (Stripe) ───────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── eBay ─────────────────────────────────────────────────────────
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_SANDBOX=true
EBAY_FORCE_REPLAY=false

# ── AliExpress ───────────────────────────────────────────────────
ALIEXPRESS_API_URL=
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# ── Observabilidade ──────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=info
# OpenTelemetry — export OTLP/HTTP (vazio = tracing desligado)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=shopfinder-web

# ── Segurança ────────────────────────────────────────────────────
# CSP em modo report-only durante rollout (#23); vazio = enforce em produção
CSP_REPORT_ONLY=

# ── App (públicas — nunca colocar segredos com NEXT_PUBLIC_) ────
NEXT_PUBLIC_APP_URL=https://shop-finder-taupe.vercel.app
NEXT_PUBLIC_SITE_URL=https://shop-finder-taupe.vercel.app
NEXT_PUBLIC_SITE_NAME=ShopFinder
NEXT_PUBLIC_DEFAULT_LOCALE=pt-BR
NEXT_PUBLIC_LOCALES=pt-BR,en
# "1" desativa o hero 3D (ambientes sem WebGL estável, ex.: runners E2E headless)
NEXT_PUBLIC_DISABLE_3D=

# ── Ambiente / Testes ────────────────────────────────────────────
NODE_ENV=development
TEST_BASE_URL=http://localhost:3000
